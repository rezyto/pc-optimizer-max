<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders every page of the app headlessly (Skia) with the fake platform and saves PNGs. Linux-friendly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PcMax.Screenshots</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PcMax.App\PcMax.App.csproj" />
  </ItemGroup>
</Project>
