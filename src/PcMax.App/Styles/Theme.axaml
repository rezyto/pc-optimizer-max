<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Palette -->
      <Color x:Key="BgColor">#0B0D17</Color>
      <SolidColorBrush x:Key="BgBrush" Color="#0B0D17" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#0F1220" />
      <SolidColorBrush x:Key="CardBrush" Color="#141829" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#191E33" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#222842" />
      <SolidColorBrush x:Key="InsetBrush" Color="#0F1222" />
      <SolidColorBrush x:Key="TextBrush" Color="#E8EAF6" />
      <SolidColorBrush x:Key="MutedBrush" Color="#8A90B2" />
      <SolidColorBrush x:Key="FaintBrush" Color="#5A6085" />
      <SolidColorBrush x:Key="CyanBrush" Color="#00E5FF" />
      <SolidColorBrush x:Key="VioletBrush" Color="#8B5CFF" />
      <SolidColorBrush x:Key="GoodBrush" Color="#22D39A" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FFB020" />
      <SolidColorBrush x:Key="CritBrush" Color="#FF4D6A" />
      <SolidColorBrush x:Key="InfoBrush" Color="#4DA3FF" />
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#00E5FF" />
        <GradientStop Offset="1" Color="#8B5CFF" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#2200E5FF" />
        <GradientStop Offset="1" Color="#228B5CFF" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#16203A" />
        <GradientStop Offset="1" Color="#1B1535" />
      </LinearGradientBrush>

      <!-- Fluent Expander colours -->
      <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#0F1222" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#151A30" />
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#151A30" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#222842" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#2C3354" />
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#2C3354" />
      <SolidColorBrush x:Key="ExpanderContentBackground" Color="#0F1222" />
      <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#222842" />

      <!-- Icons (24x24 geometry, filled) -->
      <StreamGeometry x:Key="Icon.Logo">M13,2 L4,14 H11 L10,22 L20,9 H13 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Dashboard">M3,3 H11 V13 H3 Z M13,3 H21 V9 H13 Z M13,11 H21 V21 H13 Z M3,15 H11 V21 H3 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Doctor">M9,2 H15 V9 H22 V15 H15 V22 H9 V15 H2 V9 H9 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Games">F0 M7,6 H17 C20.3,6 22.5,9 22,13 L21.3,17 C20.9,19.4 18.4,20.3 16.8,18.6 L14.6,16 H9.4 L7.2,18.6 C5.6,20.3 3.1,19.4 2.7,17 L2,13 C1.5,9 3.7,6 7,6 Z M7,9 V10.5 H5.5 V12.5 H7 V14 H9 V12.5 H10.5 V10.5 H9 V9 Z M16,9.4 A1.3,1.3 0 1 0 16,12 A1.3,1.3 0 1 0 16,9.4 Z M18.4,11.6 A1.3,1.3 0 1 0 18.4,14.2 A1.3,1.3 0 1 0 18.4,11.6 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Network">M3,17 H6 V21 H3 Z M8,13 H11 V21 H8 Z M13,9 H16 V21 H13 Z M18,4 H21 V21 H18 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Clean">F0 M9,2 H15 V4 H20 V6.5 H4 V4 H9 Z M5.5,8 H18.5 L17.5,21 C17.4,21.6 17,22 16.4,22 H7.6 C7,22 6.6,21.6 6.5,21 Z M9,10.5 V19.5 H10.6 V10.5 Z M13.4,10.5 V19.5 H15 V10.5 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.History">F0 M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M11,6 V12.6 L15.8,15.5 L16.8,13.9 L13,11.6 V6 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Settings">M3,5 H21 V7 H3 Z M3,11 H21 V13 H3 Z M3,17 H21 V19 H3 Z M7,3 H10.5 V9 H7 Z M14,9 H17.5 V15 H14 Z M6,15 H9.5 V21 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Warning">F0 M12,2 L23,21 H1 Z M11,9 V15 H13 V9 Z M11,16.5 V18.5 H13 V16.5 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Info">F0 M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M11,10 V17 H13 V10 Z M11,6.5 V8.5 H13 V6.5 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Check">F0 M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M10.4,14.2 L7.3,11.1 L5.9,12.5 L10.4,17 L18.1,9.3 L16.7,7.9 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Cpu">F0 M7,5 H17 A2,2 0 0 1 19,7 V17 A2,2 0 0 1 17,19 H7 A2,2 0 0 1 5,17 V7 A2,2 0 0 1 7,5 Z M9,9 V15 H15 V9 Z M8,1 H10 V4 H8 Z M14,1 H16 V4 H14 Z M8,20 H10 V23 H8 Z M14,20 H16 V23 H14 Z M1,8 H4 V10 H1 Z M1,14 H4 V16 H1 Z M20,8 H23 V10 H20 Z M20,14 H23 V16 H20 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Gpu">F0 M2,6 H22 V18 H2 Z M9,8.5 A3.5,3.5 0 1 0 9,15.5 A3.5,3.5 0 1 0 9,8.5 Z M16,9 V15 H19.5 V9 Z M4,19 H8 V21 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Ram">F0 M2,7 H22 V16 H2 Z M5,9.5 V13 H7.5 V9.5 Z M9.5,9.5 V13 H12 V9.5 Z M14,9.5 V13 H16.5 V9.5 Z M3,17 H5 V19 H3 Z M7,17 H9 V19 H7 Z M11,17 H13 V19 H11 Z M15,17 H17 V19 H15 Z M19,17 H21 V19 H19 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Thermo">F0 M10,3 A2.5,2.5 0 0 1 15,3 V13.5 A5,5 0 1 1 10,13.5 Z M11.6,5 V14.6 A3,3 0 1 0 13.4,14.6 V5 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Plus">M11,4 H13 V11 H20 V13 H13 V20 H11 V13 H4 V11 H11 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Close">M5.6,4.2 L12,10.6 L18.4,4.2 L19.8,5.6 L13.4,12 L19.8,18.4 L18.4,19.8 L12,13.4 L5.6,19.8 L4.2,18.4 L10.6,12 L4.2,5.6 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Undo">M7.4,7 H15 A6,6 0 0 1 15,19 H7 V17 H15 A4,4 0 0 0 15,9 H7.4 L10.2,11.8 L8.8,13.2 L3.6,8 L8.8,2.8 L10.2,4.2 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Shield">F0 M12,1 L21,5 V11 C21,16.5 17.2,21.3 12,23 C6.8,21.3 3,16.5 3,11 V5 Z M10.6,13.6 L7.9,10.9 L6.5,12.3 L10.6,16.4 L17.6,9.4 L16.2,8 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Link">M10.6,13.4 A1,1 0 0 1 9.2,13.4 A4,4 0 0 1 9.2,7.8 L12.8,4.2 A4,4 0 0 1 18.5,9.9 L16.9,11.5 A5.8,5.8 0 0 0 16.6,9.4 L17.1,8.9 A2,2 0 0 0 14.2,6 L10.6,9.6 A2,2 0 0 0 10.6,12.4 A1,1 0 0 1 10.6,13.4 Z M13.4,9.2 A1,1 0 0 1 14.8,9.2 A4,4 0 0 1 14.8,14.8 L11.2,18.4 A4,4 0 0 1 5.5,12.7 L7.1,11.1 A5.8,5.8 0 0 0 7.4,13.2 L6.9,13.7 A2,2 0 0 0 9.8,16.6 L13.4,13 A2,2 0 0 0 13.4,10.2 A1,1 0 0 1 13.4,9.2 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Folder">M2,5 A1,1 0 0 1 3,4 H9 L11,6 H21 A1,1 0 0 1 22,7 V19 A1,1 0 0 1 21,20 H3 A1,1 0 0 1 2,19 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Refresh">M17.6,6.4 A8,8 0 1 0 19.7,14 H17.6 A6,6 0 1 1 16.2,7.8 L13,11 H20 V4 Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Typography -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.caps">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{StaticResource InsetBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#0B0D17" />
    <Setter Property="Padding" Value="20,10" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#0B0D17" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#0B0D17" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A3050" />
    <Setter Property="Foreground" Value="#6A7095" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="28,14" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="#1E2440" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="#2C3354" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#273058" />
    <Setter Property="BorderBrush" Value="#3A4370" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#33FF4D6A" />
    <Setter Property="Foreground" Value="#FF8FA0" />
    <Setter Property="BorderBrush" Value="#66FF4D6A" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#55FF4D6A" />
    <Setter Property="Foreground" Value="#FFC0CA" />
    <Setter Property="BorderBrush" Value="#99FF4D6A" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#7FF2FF" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <!-- Toggle switches: no "On/Off" text -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#171B2E" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradientSoft}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem PathIcon">
    <Setter Property="Foreground" Value="{Binding $parent[ListBoxItem].Foreground}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    <Setter Property="Background" Value="#1E2440" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ProgressBar:horizontal">
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
</Styles>
