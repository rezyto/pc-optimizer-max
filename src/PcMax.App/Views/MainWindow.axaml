<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PcMax.App.ViewModels"
        xmlns:v="using:PcMax.App.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="PcMax.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PC Max"
        Icon="/Assets/pcmax.ico"
        Width="1280" Height="800" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="vm:DoctorViewModel"><v:DoctorView /></DataTemplate>
    <DataTemplate DataType="vm:GamesViewModel"><v:GamesView /></DataTemplate>
    <DataTemplate DataType="vm:NetworkViewModel"><v:NetworkView /></DataTemplate>
    <DataTemplate DataType="vm:CleanupViewModel"><v:CleanupView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><v:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="236,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,22,16,18">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,0,0,26">
          <Image Source="/Assets/pcmax.png" Width="40" Height="40" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PC Max" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Otimizador seguro" Classes="muted small" FontSize="11.5" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <Border Classes="inset" Padding="12,10">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{StaticResource FaintBrush}" IsVisible="{Binding !IsGameActive}" />
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{StaticResource GoodBrush}" IsVisible="{Binding IsGameActive}" />
                <TextBlock Text="MODO JOGO" Classes="caps" FontSize="10" />
              </StackPanel>
              <TextBlock Text="{Binding GameStatus}" FontSize="12.5" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Version}" Classes="muted" FontSize="11" Margin="6,0,0,0" Foreground="{StaticResource FaintBrush}" />
        </StackPanel>

        <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="13">
                <PathIcon Width="18" Height="18" Data="{Binding IconKey, Converter={x:Static v:IconKeyConverter.Instance}}" />
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content -->
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Margin="36,28,36,6" Spacing="4">
        <TextBlock Classes="h1" Text="{Binding CurrentPage.Title}" />
        <TextBlock Classes="muted" FontSize="14" Text="{Binding CurrentPage.Subtitle}" />
      </StackPanel>
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
  </Grid>
</Window>
