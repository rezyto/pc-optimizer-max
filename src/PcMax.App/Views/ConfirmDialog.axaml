<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PcMax.App.Views.ConfirmDialog"
        Title="PC Max" Icon="/Assets/pcmax.ico"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource CardBrush}">
  <StackPanel Margin="28,26,28,22" Spacing="14">
    <TextBlock x:Name="TitleText" Classes="h2" FontSize="19" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" Classes="body" Foreground="{StaticResource MutedBrush}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button x:Name="CancelButton" Classes="ghost" Click="OnCancel" />
      <Button x:Name="ConfirmButton" Classes="primary" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
